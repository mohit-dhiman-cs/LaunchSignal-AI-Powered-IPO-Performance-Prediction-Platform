# ── LaunchSignal Backend Configuration ─────────────────────────────────

# Port to run the Flask application server on (Defaults to 5000)
PORT=5000

# JSON Web Token Secret Key for session authentication
# Change this to a secure random string in production!
JWT_SECRET_KEY=your-secure-jwt-secret-key-change-this-in-production

# NewsAPI.org API Key (Optional)
# If provided, enables comprehensive articles fetching.
# If omitted, system falls back to Google News RSS fetcher + TextBlob NLP (completely free!).
# Acquire key at: https://newsapi.org/
NEWS_API_KEY=

# Flask Environment configuration
FLASK_ENV=development
